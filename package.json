{
  "name": "monitoringartist-logicmonitorotelmetrics-datasource",
  "description": "Grafana datasource that queries LogicMonitor OpenTelemetry metrics with PromQL via the LogicMonitor OTel Metrics API",
  "version": "1.0.0",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers=50%",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix . && prettier --write --list-different .",
    "e2e": "playwright test",
    "e2e:local": "node scripts/e2e-local.js",
    "server": "docker compose up --remove-orphans --build",
    "server:mock": "docker compose -f docker-compose.yaml -f docker-compose.mock.yaml up --remove-orphans --build",
    "sign": "sign-plugin",
    "i18n-extract": "npm run i18n-extract:plugin",
    "i18n-extract:plugin": "i18next-cli extract --sync-primary --config i18next.plugin.config.ts"
  },
  "author": "Monitoring Artist",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "4.1.1",
    "@grafana/sign-plugin": "4.0.0",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "52.0.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.2.0",
    "glob": "14.0.6",
    "i18next-cli": "1.91.3",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.10.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.108.2",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "overrides": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "basic-ftp": "^6.2.1",
    "moment": "2.31.0",
    "@grafana/plugin-ui": {
      "@grafana/data": "$@grafana/data",
      "@grafana/ui": "$@grafana/ui",
      "@grafana/runtime": "$@grafana/runtime",
      "@grafana/e2e-selectors": "$@grafana/e2e-selectors"
    },
    "@grafana/scenes": {
      "@grafana/data": "$@grafana/data",
      "@grafana/ui": "$@grafana/ui",
      "@grafana/runtime": "$@grafana/runtime",
      "@grafana/schema": "$@grafana/schema",
      "@grafana/e2e-selectors": "$@grafana/e2e-selectors"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/assistant": "0.1.34",
    "@grafana/data": "13.1.7",
    "@grafana/e2e-selectors": "13.1.7",
    "@grafana/i18n": "13.1.7",
    "@grafana/plugin-ui": "0.17.6",
    "@grafana/prometheus": "13.2.4",
    "@grafana/runtime": "13.1.7",
    "@grafana/schema": "13.1.7",
    "@grafana/ui": "13.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  }
}
